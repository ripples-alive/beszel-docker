diff --git a/internal/hub/transport/ssh.go b/internal/hub/transport/ssh.go
index 8d49646..79e3a2d 100644
--- a/internal/hub/transport/ssh.go
+++ b/internal/hub/transport/ssh.go
@@ -6,6 +6,7 @@ import (
 	"fmt"
 	"io"
 	"net"
+	"os"
 	"strings"
 	"sync"
 	"time"
@@ -14,6 +15,7 @@ import (
 	"github.com/fxamacker/cbor/v2"
 	"github.com/henrygd/beszel/internal/common"
 	"golang.org/x/crypto/ssh"
+	"golang.org/x/net/proxy"
 )
 
 // sshKeepAliveInterval is the TCP keep-alive idle interval for SSH connections
@@ -200,7 +202,20 @@ func (t *SSHTransport) Connect(ctx context.Context) (*ssh.Client, error) {
 	}
 
 	dialer := net.Dialer{Timeout: t.config.Timeout, KeepAlive: sshKeepAliveInterval}
-	conn, err := dialer.DialContext(ctx, network, host)
+	var conn net.Conn
+	var err error
+	proxyHost := os.Getenv("PROXY_HOST")
+	proxyPort := os.Getenv("PROXY_PORT")
+	if network == "tcp" && proxyHost != "" && proxyPort != "" {
+		proxyAddr := net.JoinHostPort(proxyHost, proxyPort)
+		socksDialer, dialerErr := proxy.SOCKS5("tcp", proxyAddr, nil, &dialer)
+		if dialerErr != nil {
+			return nil, fmt.Errorf("failed to create SOCKS5 proxy dialer: %w", dialerErr)
+		}
+		conn, err = socksDialer.Dial(network, host)
+	} else {
+		conn, err = dialer.DialContext(ctx, network, host)
+	}
 	if err != nil {
 		return nil, err
 	}
